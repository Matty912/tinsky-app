# Copiá este archivo a ".env" (sin el ".example") y completá con los datos
# de tu proyecto de Supabase (Project Settings → API).
#
# Si dejás este archivo vacío o no creás el .env, la app funciona igual
# pero guarda los datos solo en el navegador de esa compu (localStorage).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
